{
  "name": "geoplay",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "postinstall": "node scripts/init-env.mjs",
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run prisma:deploy -w apps/api",
    "db:seed": "npm run prisma:seed -w apps/api",
    "dev:api": "npm run start:dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "db:down": "docker compose down",
    "setup": "npm run db:up && npm run db:migrate && npm run db:seed && npm run data:worldbank",
    "data:worldbank": "npm run data:worldbank -w apps/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}